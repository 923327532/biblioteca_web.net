@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = ViewData["Title"] ?? "Detalle de libro";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-2">Titulo</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>
    <dt class="col-sm-2">ISBN</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>
    <dt class="col-sm-2">Autor</dt>
    <dd class="col-sm-10">@Model.Autor</dd>
    <dt class="col-sm-2">Ejemplares</dt>
    <dd class="col-sm-10">@Model.Ejemplares</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
