@model IEnumerable<Biblioteca.Web.Models.Libro>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo libro</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input name="titulo" value="@ViewData["TituloBusqueda"]" class="form-control" placeholder="Buscar por titulo" />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Titulo</th>
            <th>ISBN</th>
            <th>Autor</th>
            <th>Ejemplares</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var libro in Model)
    {
        <partial name="_LibroFila" model="libro" />
    }
    </tbody>
</table>
