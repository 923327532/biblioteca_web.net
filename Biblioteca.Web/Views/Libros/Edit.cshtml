@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = ViewData["Title"] ?? "Editar libro";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="Edit" asp-route-id="@Model.LibroId" method="post">
    <input type="hidden" asp-for="LibroId" />
    <partial name="_LibroFormulario" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
