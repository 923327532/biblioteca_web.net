@model IEnumerable<Biblioteca.Web.Models.Socio>

@{
    ViewData["Title"] = ViewData["Title"] ?? "Socios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo socio</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var socio in Model)
    {
        <tr>
            <td>@socio.DNI</td>
            <td>@socio.Nombre</td>
            <td>@socio.Email</td>
        </tr>
    }
    </tbody>
</table>
